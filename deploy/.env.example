# Copie para .env no servidor e preencha com valores reais (NÃO versionar o .env real).
POSTGRES_DB=fluxocaixa
POSTGRES_USER=fluxocaixa
POSTGRES_PASSWORD=defina-uma-senha-forte

# Chave JWT de produção (>= 32 caracteres, aleatória). Gere com: openssl rand -base64 48
JWT_KEY=defina-uma-chave-aleatoria-forte

# Admin inicial (seed)
ADMIN_EMAIL=junior322222@gmail.com
ADMIN_SENHA=123456

# Porta do host para o container web (o nginx do host faz proxy para ela)
WEB_PORT=8091
